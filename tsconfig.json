{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    // rootDir is "src" (not ".") so tsc emits dist/server.js — the path package.json's
    // "main"/"start" point at. With rootDir "." the output nested to dist/src/server.js
    // and `npm run build && npm start` failed to find it.
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  // scripts/ is excluded from the build: hello.ts is a throwaway SDK smoke test run
  // through tsx, and including it would force rootDir back to "." (see above).
  // Tests are deliberately included here so `npm run typecheck` covers them too;
  // tsconfig.build.json excludes them from the emitted dist/.
  "include": ["src"]
}
