DEEPGRAM_API_KEY=
PORT=3000
DESTINATIONS=crm,analytics
CRM_WEBHOOK_URL=http://localhost:3000/mock-crm

# Stage 4: Deepgram Read (summarize + topics) on the same prerecorded request.
INTELLIGENCE_ENABLED=false

# Stage 6: shadow-run validation. Off by default because it costs a SECOND full
# transcription per call (baseline model) — see src/pipeline/validate.ts.
VALIDATION_ENABLED=false

# LLM_API_KEY=   # optional, only if structured summary uses an LLM
