{
  "name": "deepgram-demo",
  "version": "1.0.0",
  "description": "DataVoice Inc. Deepgram reference integration — batch call pipeline demo",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "hello": "tsx scripts/hello.ts",
    "test": "node --import tsx --test src/pipeline/*.test.ts src/sinks/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"public/**/*.js\" \"*.json\" \"eslint.config.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"public/**/*.js\" \"*.json\" \"eslint.config.js\"",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@deepgram/sdk": "^5.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
